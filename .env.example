# ---- Which model to use (change only these two lines) ----
LLM_PROVIDER=anthropic
MODEL_NAME=claude-haiku-5-5
CRITIC_MODEL=claude-sonnet-5-5

# Other options:
#   LLM_PROVIDER=anthropic   MODEL_NAME=claude-sonnet-5-5      (final demo runs)
#   LLM_PROVIDER=gemini      MODEL_NAME=gemini-2.5-flash-lite  (free backup)

# ---- Keys (never share these) ----
ANTHROPIC_API_KEY=your-anthropic-key-here
GOOGLE_API_KEY=your-google-key-here